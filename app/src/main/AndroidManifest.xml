<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network is Wi-Fi or mobile data: updates fetch by themselves on Wi-Fi only. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fingerprint unlock: the system's own prompt; Nesty never sees a fingerprint. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Exit plans and alerts with Nesty closed: a foreground service with its notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android's own question to let Nesty run in the background; the user answers it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Updates: Nesty hands its own new APK to Android's installer, which asks the user. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12 and later: without that question, only if the user turns it on. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".NestyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nesty">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".alerts.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches the user's exit plans (take profit, trailing stop, stop loss) and sells when a step is due, with the app closed." />
        </service>

        <!-- Android's answers to an update Nesty handed it: its question, or how it ended. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- The new version's first start after an update. -->
        <receiver
            android:name=".update.ReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
